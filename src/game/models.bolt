#     Inactive = "inactive"


class PlayerCount(CustomBaseModel):
    min: int = 2
    max: int = 100

    @model_validator(mode='after')
    def max_at_least_min(self):
        if self.max < self.min:
            raise ValueError(
                f"max ({self.max}) must be >= min ({self.min})"
            )
        
        return self


class Gamemode(CustomBaseModel):
    id: str
    player_count: PlayerCount = Field(default_factory=PlayerCount)


class Team(CustomBaseModel):
    id: str

    @property
    def name(self) -> str:
        return self.id.replace("_", " ").title()


class Map(CustomResource, storage=STORAGE.rom.game.maps):
    id: str
    gamemode: Gamemode

    # eventually, all maps will be '0 0 0' in a custom dimension
    location: str
    dimension: str = "overworld"
    # tags: list[str] = Field(default_factory=list, validate_default=True)

    # TODO: store name on map generated dynamically
    @property                                   
    def name(self) -> str:                      
        return self.id.replace("_", " ").title()
    
    def on_load(self):
        super().on_load()


