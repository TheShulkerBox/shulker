from pydantic import InstanceOf, field_serializer, field_validator, model_validator

from item:type import ItemType
from lib:custom_resources import CustomBaseModel
from lib:const import TEAM_COLORS
from lib:types import LocationStr

from ../models import Gamemode, Map, Team, PlayerCount


class CTFTeam(Team):
    team_color: str
    head_item: InstanceOf[ItemType]
    flag_location: LocationStr
    player_spawn: LocationStr

    @field_serializer("head_item")
    def serialize_head_item(self, head_item: ItemType):
        return head_item.as_dict()

    @field_validator("team_color")
    def validate_color(cls, team_color: str):
        if team_color not in TEAM_COLORS:
            raise ValueError(f"{team_color!r} needs to be one of: {TEAM_COLORS}")

        return team_color


class CTF(Gamemode):
    id: str = "ctf"
    name: str = "Capture the Flag"
    
    teams: list[CTFTeam]
    kill_points_awarded: int = 1
    flag_points_awarded: int = 20
    player_count: PlayerCount = PlayerCount(min=4)

