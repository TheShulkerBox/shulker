ON_GROUND_PREDICATE = {type: "minecraft:entity_properties", entity: "this", predicate: {"minecraft:flags": {is_on_ground: true}}}
SNEAKING_PREDICATE = {type: "minecraft:entity_properties", entity: "this", predicate: {flags: {is_sneaking: true}}}

def entity_condition(predicate: dict[str, Any]):
    """Wrap entity properties in the explicit predicate required by advancement filters."""
    return {"type": "minecraft:entity_properties", "entity": "this", "predicate": predicate}

def has_item_predicate(pred: dict[str, Any]):
    return {
        type: "minecraft:any_of",
        terms: [
            {
                type: "minecraft:entity_properties",
                entity: "this",
                predicate: {
                    "minecraft:slots": { "inventory.*": pred }
                }
            },
            {
                type: "minecraft:entity_properties",
                entity: "this",
                predicate: {
                    "minecraft:slots": { "hotbar.*": pred }
                }
            },
            {
                type: "minecraft:entity_properties",
                entity: "this",
                predicate: {
                    "minecraft:slots": { "weapon.*": pred }
                }
            },
            {
                type: "minecraft:entity_properties",
                entity: "this",
                predicate: {
                    "minecraft:slots": { "player.cursor": pred }
                }
            },
            {
                type: "minecraft:entity_properties",
                entity: "this",
                predicate: {
                    "minecraft:slots": { "player.crafting.*": pred }
                }
            }
        ]
    }
