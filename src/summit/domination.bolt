from lib.text import Theme

from kit:definitions/archer import archer
from kit:definitions/assassin import assassin
from kit:definitions/barbarian import barbarian
from kit:definitions/berserker import berserker
from kit:definitions/footman import footman
from kit:definitions/headsman import headsman
from kit:definitions/juggernaut import juggernaut
from kit:definitions/ranger import ranger
from kit:definitions/spearfisher import Spearfisher
from kit:definitions/swashbuckler import swashbuckler
from kit:definitions/warbowman import warbowman
from kit:definitions/witch_doctor import witch_doctor
# Summit only V
from kit:services/resupply import TICK_RESUPPLY_TIME
from ./battlegrounds import Battleground, PLAYER_TAG, TIME_LEFT

WIN_THRESHOLD: int = 100
BOSSBAR_MIDDLE: int = 50
#> TODO: 
# Figure out why I can't make this dynamic
#BOSSBAR_MIDDLE = (WIN_THRESHOLD/2)

# Tags
BOOTH_ID = "shulker"
DOMINATION_POINT_ENTITY = "shulker.domination_control_point"
# Control points are expected to be marker entities. The arena structure currently
# doesn't contain the tagged points, so keep this in sync with the live booth setup.
DOMINATION_POINT_TYPE = "marker"

# Fake players
GAME_SCORE = "#shulker.domination.score"

# Bossbar
DOMINATION_BOSSBAR = "shulker:game.domination.global_score"

# Scoreboard objectives
GAME_STATE = Scoreboard("shulker.domination.game_state", criteria="dummy")

# Function Paths
ARENA_LOAD: FunctionPath = ./load
ARENA_UNLOAD: FunctionPath = ./unload
PLAYER_ENTER_SUCCESS: FunctionPath = ./player_enter_success
PLAYER_LEAVE: FunctionPath = ./player_leave
DOMINATION_MAIN: FunctionPath = ./domination/main
BOOTH_STRUCTURE_SET: FunctionPath = ./domination/arena_structure
UPDATE_CLOCK: FunctionPath = ./domination/clock
GIVE_RANDOM_KIT: FunctionPath = ./domination/give_random_kit

DEFAULT_KITS = [
    archer,
    assassin,
    barbarian,
    berserker,
    footman,
    headsman,
    juggernaut,
    ranger,
    Spearfisher,
    swashbuckler,
    warbowman,
    witch_doctor,
]

BATTLEGROUND = Battleground(
    booth_id=BOOTH_ID,
    booth_name="The Shulker Box",
    return_pos="[43.48d, 148.00d, -82.29d]",
    return_rot="[-243.08f, 1.67f]",
    structure_function=BOOTH_STRUCTURE_SET,
    compatibility=BOOTH_ID,
    kit_function=GIVE_RANDOM_KIT,
    on_active=ARENA_LOAD,
    on_inactive=ARENA_UNLOAD,
    on_enter=PLAYER_ENTER_SUCCESS,
    on_leave=PLAYER_LEAVE,
)

def show_subtitle(message: str, color: str, quick: bool = False):
    """Show a subtitle while clearing the main title afterward."""
    if quick:
        title @s times 1t 1s 1t
    title @s subtitle {"text": message, "color": color}
    title @s title {"text": ""}
    title @s reset

function GIVE_RANDOM_KIT:
    execute store result score var SCORE.temp["#summit_random_kit"] run random value (0, len(DEFAULT_KITS) - 1)
    for index, kit in enumerate(DEFAULT_KITS):
        kit_function = f"shulker:kit/loadout/{kit.id}/apply"
        execute if score var SCORE.temp["#summit_random_kit"] matches index run return run function kit_function

# Domination gamemode main loop
function DOMINATION_MAIN:
    BATTLEGROUND.require_active()
    function TICK_RESUPPLY_TIME
    schedule function DOMINATION_MAIN 1t

    # Tick domination point entities. We'll change team score based on the balance of nearby players
    #> TODO:
    # We might instead make point control flip by adding another layer of buffer, making PLAYER_BALANCE set the first derivative (rate of change) for control of the point, with control state being determining which teams collects a set amount of progress per score tick.
    SCORE.temp["#domination_score_changed"] = 0
    execute as @e[type=DOMINATION_POINT_TYPE,tag=DOMINATION_POINT_ENTITY] at @s:
        # Count each team around this point independently. The temporary counts and
        # counts are rebuilt every tick, so players leaving cannot leave stale capture
        # pressure behind.
        SCORE.temp["#domination_team_1"] = 0
        SCORE.temp["#domination_team_2"] = 0
        execute as @a[tag=PLAYER_TAG,distance=..5,scores={game.team=1}] run scoreboard players add #domination_team_1 temp 1
        execute as @a[tag=PLAYER_TAG,distance=..5,scores={game.team=2}] run scoreboard players add #domination_team_2 temp 1
        # If balance for the capture point is in team 1's favor
        if SCORE.temp["#domination_team_1"] > SCORE.temp["#domination_team_2"]:
            GAME_STATE[GAME_SCORE] += 1
            SCORE.temp["#domination_score_changed"] = 1
        # If balance for the capture point is in team 2's favor
        elif SCORE.temp["#domination_team_1"] < SCORE.temp["#domination_team_2"]:
            GAME_STATE[GAME_SCORE] -= 1
            SCORE.temp["#domination_score_changed"] = 1
        # If balance for the capture point is neutral
        else:
            ...
    # Avoid rewriting the bossbar and checking win conditions on neutral ticks.
    if SCORE.temp["#domination_score_changed"] == 1:
        execute store result bossbar DOMINATION_BOSSBAR value run scoreboard players get var GAME_STATE[GAME_SCORE]
        # Team 1 wins
        if GAME_STATE[GAME_SCORE] <= 0:
            ...
        # Team 2 wins
        elif GAME_STATE[GAME_SCORE] >= WIN_THRESHOLD:
            ...

function UPDATE_CLOCK:
    BATTLEGROUND.require_active()
    schedule function UPDATE_CLOCK 20t
    if TIME_LEFT == 40:
        execute as @a[tag=PLAYER_TAG] at @s:
            show_subtitle("30 seconds remaining!", Theme.Secondary)
    # The match timer ticks once per second. Its final values, 15 through 11,
    # correspond to the player-facing 5-to-1 countdown.
    for timer_value, countdown_number in [(15, "5"), (14, "4"), (13, "3"), (12, "2"), (11, "1")]:
        if TIME_LEFT == timer_value:
            execute as @a[tag=PLAYER_TAG] at @s:
                show_subtitle(countdown_number, Theme.Secondary, quick=True)
                playsound minecraft:block.note_block.hat voice @s ~ ~ ~ 0.5 1.189207
    if TIME_LEFT == 10:
        execute as @a[tag=PLAYER_TAG] at @s:
            show_subtitle("Time's up!", Theme.Failure)
        # Announce end of match to all nearby players, regardless of whether they're in the arena
        #> TODO:
        # Review with rx so we don't break any rules.
        playsound minecraft:item.goat_horn.sound.1 voice @a -98 81 118 5 0.5
        

# Event functions tied into API below
function BOOTH_STRUCTURE_SET:
    BATTLEGROUND.set_structure("shulker:battlegrounds/arena")

function ARENA_LOAD:
    schedule function DOMINATION_MAIN 1t
    schedule function UPDATE_CLOCK 1t
    bossbar add DOMINATION_BOSSBAR [{text:'Red',color:dark_red},{text:' '},{text:' '},{text:' '},{text:' '},{text:' '},{text:' Team Victory Progress ',color:white},{text:' '},{text:' '},{text:' '},{text:' '},{text:' '},{text:'Blue',color:dark_blue}]
    bossbar set DOMINATION_BOSSBAR style notched_20
    bossbar set DOMINATION_BOSSBAR max WIN_THRESHOLD
    bossbar set DOMINATION_BOSSBAR color white
    GAME_STATE[GAME_SCORE] = BOSSBAR_MIDDLE
    playsound minecraft:item.goat_horn.sound.0 voice @a -98 81 118 5 0.5
    
function ARENA_UNLOAD:
    bossbar remove DOMINATION_BOSSBAR

function PLAYER_ENTER_SUCCESS:
    bossbar set DOMINATION_BOSSBAR players @a[tag=PLAYER_TAG]

function PLAYER_LEAVE:
    bossbar set DOMINATION_BOSSBAR players @a[tag=PLAYER_TAG]
