"""Domination scoring, match clock, and victory handling."""

from kit:services/resupply import TICK_RESUPPLY_TIME
from ../battlegrounds import PLAYER_TAG
from ../stickers import WIN_A_GAME_STICKER
from ./config import BLUE_TEAM, BLUE_TEXT_COLOR
from ./config import CAPTURE_RADIUS, CRATE_PARTICLE_COLOR, DOMINATION_POINTS
from ./config import DOMINATION_POINT_ENTITY
from ./config import DOMINATION_POINT_TYPE, MATCH_DURATION_SECONDS
from ./config import DRAW_TEXT_COLOR
from ./config import POINT_DEBUG_PARTICLE_COLOR
from ./config import POINT_CAPTURE_DAMAGE_PER_TICK, POINT_CAPTURE_HEALTH
from ./config import POINT_REGEN_INTERVAL_TICKS, PROGRESS_PER_CONTROLLED_POINT
from ./config import RED_TEAM, RED_TEXT_COLOR
from ./config import RESPAWN_DEBUG_PARTICLE_COLOR, RESUPPLY_DEBUG_PARTICLE_COLOR
from ./config import RESPAWN_POINT_POSITIONS, RESUPPLY_CRATE_POSITIONS
from ./config import SCORING_INTERVAL_TICKS
from ./config import STARTING_SCORE, SUMMIT_BOOTH_ENTITY_TAG, WIN_THRESHOLD
from ./config import SUBTITLE_COLOR, DEBUG
from ./registry import BATTLEGROUND
from ./registry import AWARD_CONTROL_POINTS, BLUE_WIN, CAPTURE_POINTS
from ./registry import DEBUG_POINT_PARTICLES
from ./registry import DOMINATION_BOSSBAR, DOMINATION_MAIN, DOMINATION_TEAM
from ./registry import GAME_SCORE, GAME_STATE, MATCH_DRAW, MATCH_FINISHED
from ./registry import MATCH_TIME_LEFT, MATCH_TIME_UP, POINT_REGEN_TIMER, RED_WIN
from ./registry import SCORING_TIMER


def show_subtitle(message: str, color: str, quick: bool = False):
    """Show a match subtitle with normal or countdown timing."""
    title @s reset
    if quick:
        title @s times 1t 1s 1t
    else:
        title @s times 5t 2s 10t
    title @s subtitle {text: message, color: color}
    title @s title {text: ""}


