"""Kill-based sticker progress for Summit Domination."""

from player:events import ON_KILL

from ../battlegrounds import PLAYER_TAG
from ../stickers import GET_3_KILLS_STICKER
from ./registry import BATTLEGROUND, SESSION_KILLS


append function ON_KILL:
    # The kill event is global, so only active participants count here.
    BATTLEGROUND.require_active()
    execute unless entity @s[tag=PLAYER_TAG] run return 0

    SESSION_KILLS["@s"] += 1
    execute if score @s SESSION_KILLS matches 3.. run advancement grant @s only GET_3_KILLS_STICKER
