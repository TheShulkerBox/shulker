ARENA_STRUCTURE_SIZE = (39, 17, 45)
DOMINATION_POINT_ENTITY = "shulker.domination_control_point"
DOMINATION_POINT_TYPE = "marker"
SUMMIT_BOOTH_ENTITY_TAG = "summit.booth_entity.shulker"
