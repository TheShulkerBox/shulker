class Banner:
    def set(name: str, banner_color: str = "light_gray"):
        data modify entity name item set value {id: f"minecraft:{banner_color}_banner"}

    def set_contested(name: str, banner_color: str = "light_gray"):
        data modify entity name item set value {
            id: f"minecraft:{banner_color}_banner",
            components: {
                "minecraft:banner_patterns": [
                    {color: "white", pattern: "minecraft:cross"},
                    {color: "brown", pattern: "minecraft:stripe_top"},
                    {color: banner_color, pattern: "minecraft:triangle_top"},
                    {color: banner_color, pattern: "minecraft:border"}
                ]
            }
        }
