"""Shared Domination configuration and Battlegrounds registration.

Import this module anywhere Domination needs to interact with Summit. It owns the
single ``Battleground`` instance, so every module uses the same active-session
guard and lifecycle registration.
"""

from ../battlegrounds import Battleground


# Booth identity and arena layout.
BOOTH_ID = "shulker"
ARENA = "shulker:battlegrounds/arena"


# Match state shared by lifecycle and scoring functions.
GAME_SCORE = "$shulker.domination.score"
LAST_TIME_LEFT = "$shulker.domination.last_time_left"
SCORING_TIMER = "$shulker.domination.scoring_timer"
POINT_REGEN_TIMER = "$shulker.domination.point_regen_timer"
MATCH_FINISHED = "$shulker.domination.finished"
DOMINATION_BOSSBAR = "shulker:game.domination.global_score"
GAME_STATE = Scoreboard("shulker.domination.game_state", criteria="dummy")
DOMINATION_TEAM = Scoreboard("shulker.summit.domination.team", criteria="dummy")
# Summit displays this shared objective below player names. Shulker owns each
# participant's score only while they are in its Battlegrounds session.
SESSION_KILLS = Scoreboard("summit.below_name")

# Stable function paths used by the Summit API and external debug commands.
ARENA_LOAD: FunctionPath = ./load
ARENA_UNLOAD: FunctionPath = ./unload
PLAYER_ENTER_SUCCESS: FunctionPath = ./player_enter_success
PLAYER_LEAVE: FunctionPath = ./player_leave
PLAYER_DIED: FunctionPath = ./player_died
DOMINATION_MAIN: FunctionPath = ./main
CAPTURE_POINTS: FunctionPath = ./capture_points
AWARD_CONTROL_POINTS: FunctionPath = ./award_control_points
RED_WIN: FunctionPath = ./red_win
BLUE_WIN: FunctionPath = ./blue_win
END_WITH_RED_WIN: FunctionPath = ./end_with_red_win
END_WITH_BLUE_WIN: FunctionPath = ./end_with_blue_win
MATCH_DRAW: FunctionPath = ./match_draw
MATCH_TIME_UP: FunctionPath = ./match_time_up
DEBUG_POINT_PARTICLES: FunctionPath = ./debug_point_particles
REMOVE_BOSSBAR: FunctionPath = ./remove_bossbar
APPLY_RANDOM_KIT: FunctionPath = ./apply_random_kit
GIVE_RANDOM_KIT: FunctionPath = ./give_random_kit
RANDOM_KIT_LOADOUT: FunctionPath = "shulker:kit/loadout/random/apply"
RESET_RESUPPLY_TIMER: FunctionPath = ./reset_resupply_timer
RESET_SUMMIT_KIT_STATE: FunctionPath = ./reset_summit_kit_state
CLEANUP_SUMMIT_KIT_ENTITIES: FunctionPath = ./cleanup_summit_kit_entities
SPAWN_FOR_TEAM: FunctionPath = ./spawn_for_team


# This is the only Domination Battleground instance. Other modules import it
# rather than creating their own registration or duplicating lifecycle guards.
BATTLEGROUND = Battleground(
    booth_id=BOOTH_ID,
    booth_name="The Shulker Box",
    return_pos="[-112.37d, 69.00d, 82.96d]",
    return_rot="[-1.54d, -10.16d]",
    arena=ARENA,
    compatibility=BOOTH_ID,
    kit_function=RANDOM_KIT_LOADOUT,
    on_active=ARENA_LOAD,
    on_inactive=ARENA_UNLOAD,
    on_enter=PLAYER_ENTER_SUCCESS,
    on_leave=PLAYER_LEAVE,
    on_died=PLAYER_DIED,
)
