from typing import Any

from server:core import ROOT_ADVANCEMENT
from lib:errors import CustomComponentError
from lib:helpers import nbt_dump
from lib:const import HAND_SLOTS

from ./type import Component
from ./kill import item_match

class Strike(Component):
    """This component will activate when you strike someone.
    
    By default, this component will only activate if this item was used to strike someone.
    """
    attacker: FunctionPath | None = None
    victim: FunctionPath | None = None
    attacker_slot: Annotated[str, "Slot the attacker must have the item equipped in"] = "hotbar.*"
    victim_slot: Annotated[str, "Slot the attacking player must have the item equipped in"] = "hotbar.*"
    crit: Annotated[bool, "Whether the strike was a critical hit or not"] = False
    # assistant: str = ""

    def build(self):
        if not (self.attacker or self.victim):
            raise CustomComponentError(
                "At least one of `attacker` or `victim` must be defined"
            )

        # attacker: we did the strike, so the item-holder is the `player`
        if self.attacker:
            attacker_advancement = f"{self.path}/attacker"
            attacker_reward = f"{attacker_advancement}/reward"

            advancement attacker_advancement {
                "parent": ROOT_ADVANCEMENT,
                "criteria": {
                    "attacker": {
                        "trigger": "minecraft:player_hurt_entity",
                        "conditions": {
                            "entity": { "entity_type": "player" },
                            "player": item_match(self.item, self.attacker_slot)
                        }
                    }
                },
                "rewards": { "function": attacker_reward }
            }

            function attacker_reward:
                advancement revoke @s only attacker_advancement
                function self.attacker

        # victim: the attacker is the `entity`, so merge the match into it
        if self.victim:
            victim_advancement = f"{self.path}/victim"
            victim_reward = f"{victim_advancement}/reward"
            victim_source = { "entity_type": "player" } | item_match(self.item, self.victim_slot)

            advancement victim_advancement {
                "parent": ROOT_ADVANCEMENT,
                "criteria": {
                    "victim": {
                        "trigger": "minecraft:entity_hurt_player",
                        "conditions": { "damage": { "source_entity": victim_source } }
                    }
                },
                "rewards": { "function": victim_reward }
            }

            function victim_reward:
                advancement revoke @s only victim_advancement
                function self.victim
